{
  "$schema": "https://opencode.ai/config.json",
  "model": "vllm-conductor/active-model",
  "default_agent": "goal_combined",
  "enabled_providers": ["vllm-conductor", "opencode"],
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "bash": "allow",
    "edit": "deny",
    "task": "allow",
    "todowrite": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "lsp": "deny",
    "skill": "deny"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 4096
  },
  "snapshot": false,
  "instructions": ["AGENTS.md"],
  "provider": {
    "opencode": {
      "options": {
        "apiKey": "{env:OPENCODE_ZEN_API_KEY}",
        "timeout": 900000,
        "chunkTimeout": 600000
      }
    },
    "vllm-conductor": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Qwen local conductor",
      "options": {
        "baseURL": "http://127.0.0.1:8002/v1",
        "apiKey": "local",
        "timeout": 900000,
        "chunkTimeout": 600000
      },
      "models": {
        "active-model": {
          "name": "Qwen3 4B AWQ vLLM",
          "limit": {
            "context": 32768,
            "output": 2048
          },
          "max_tokens": 2048,
          "tool_call": true,
          "reasoning": false
        }
      }
    }
  },
  "mcp": {
    "agent_contract": {
      "type": "local",
      "command": ["node", ".opencode/mcp/agent_contract/server.js"],
      "enabled": true
    },
    "safe_edit": {
      "type": "local",
      "command": ["node", ".opencode/mcp/safe_edit/server.js"],
      "enabled": true
    },
    "web_check": {
      "type": "local",
      "command": ["node", ".opencode/mcp/web_check/server.js"],
      "enabled": true
    },
    "web_research": {
      "type": "local",
      "command": ["node", ".opencode/mcp/web_research/server.js"],
      "enabled": true
    },
    "gemma_reason": {
      "type": "local",
      "command": ["node", ".opencode/mcp/gemma_reason/server.js"],
      "enabled": true,
      "environment": {
        "GEMMA_REASON_BASE_URL": "http://127.0.0.1:8004/v1",
        "GEMMA_REASON_MODEL": "active-model",
        "GEMMA_REASON_API_KEY": "local"
      }
    }
  }
}

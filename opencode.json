{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ieti-agents": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "IETI Agents",
      "options": {
        "baseURL": "https://agents.ieti.site/v1",
        "apiKey": "{file:.secrets/agents_server_key}",
        "timeout": 900000,
        "chunkTimeout": 600000
      },
      "models": {
        "deepseek-model": {
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "none": {
              "disabled": true
            },
            "minimal": {
              "disabled": true
            },
            "low": {
              "disabled": true
            },
            "medium": {
              "disabled": true
            },
            "high": {
              "disabled": true
            },
            "xhigh": {
              "disabled": true
            },
            "max": {
              "disabled": true
            }
          }
        },
        "active-model": {
          "limit": {
            "context": 100000,
            "output": 8192
          },
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "minimal": {
              "disabled": true
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "disabled": true
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "disabled": true
            }
          },
          "options": {
            "reasoningEffort": "none"
          }
        }
      }
    }
  },
  "model": "ieti-agents/deepseek-model",
  "mcp": {
    "google-sheets": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "mcp<2",
        "mcp-google-sheets@latest"
      ],
      "enabled": true,
      "environment": {
        "SERVICE_ACCOUNT_PATH": "{file:.secrets/my-project-1539978691845-3da2dfd4581b.json}",
        "DRIVE_FOLDER_ID": "13sQk-Q67v9JUVfwy9tyGOJRZ3zdCnpwC"
      }
    },
    "graphrepo": {
      "type": "local",
      "command": [
        "node",
        "/Users/albertpalaciosjimenez/.opencode/graphrepo/dist/mcp-server.cjs",
        "serve"
      ],
      "enabled": true,
      "environment": {
        "GRAPHREPO_DATA_FILE": "/Users/albertpalaciosjimenez/Documents/GitHub/XTEC-CursAgentsIA/.graphrepo/graph.json",
        "GRAPHREPO_REPO_PATH": "/Users/albertpalaciosjimenez/Documents/GitHub/XTEC-CursAgentsIA"
      }
    },
    "gmail": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@klodr/gmail-mcp"
      ],
      "enabled": true,
      "environment": {
        "GMAIL_OAUTH_PATH": "/Users/albertpalaciosjimenez/Documents/GitHub/XTEC-CursAgentsIA/.secrets/gcp-oauth.keys.json"
      }
    }
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-vllm/qwen3-8b-local",
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": "ask",
    "edit": "ask",
    "task": "allow",
    "todowrite": "allow",
    "lsp": "allow",
    "skill": "allow"
  },
  "provider": {
    "spark-vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Spark vLLM",
      "options": {
        "baseURL": "http://127.0.0.1:8002/v1",
        "apiKey": "local",
        "timeout": 600000,
        "chunkTimeout": 120000
      },
      "models": {
        "Qwen/Qwen3.6-27B": {
          "name": "Qwen/Qwen3.6-27B",
          "max_tokens": 8192
        }
      }
    },
    "local-vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local vLLM",
      "options": {
        "baseURL": "http://127.0.0.1:8001/v1",
        "apiKey": "local",
        "timeout": 600000,
        "chunkTimeout": 120000
      },
      "models": {
        "qwen3-8b-local": {
          "name": "Qwen3 8B AWQ Local (64K)",
          "max_tokens": 8192,
          "tool_call": true,
          "reasoning": true
        },
        "gemma4-8b-local": {
          "name": "Gemma 4 8B Local (64K)",
          "max_tokens": 8192,
          "tool_call": true,
          "reasoning": true
        }
      }
    }
  },
  "mcp": {
    "safe-edit": {
      "type": "local",
      "command": [
        "node",
        ".opencode/mcp/safe-edit/server.js"
      ],
      "enabled": true
    }
  }
}

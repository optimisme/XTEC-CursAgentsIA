{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-vllm/gemma4-8b-local",
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": "allow",
    "edit": "deny",
    "task": "deny",
    "todowrite": "allow",
    "lsp": "allow",
    "skill": "allow"
  },
  "instructions": [
    "AGENTS.md",
    "docs/*.md"
  ],
  "provider": {
    "spark-vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Spark vLLM",
      "options": {
        "baseURL": "http://127.0.0.1:8001/v1",
        "apiKey": "local",
        "timeout": 900000,
        "chunkTimeout": 240000
      },
      "models": {
        "Qwen/Qwen3.6-27B": {
          "name": "Qwen/Qwen3.6-27B (32K)",
          "max_tokens": 4096
        }
      }
    },
    "local-vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local vLLM",
      "options": {
        "baseURL": "http://127.0.0.1:8002/v1",
        "apiKey": "local",
        "timeout": 900000,
        "chunkTimeout": 240000
      },
      "models": {
        "qwen3-8b-local": {
          "name": "Qwen3 8B AWQ Local (32K)",
          "max_tokens": 4096,
          "tool_call": true,
          "reasoning": true
        },
        "qwen3-14b-local": {
          "name": "Qwen3 14B AWQ Local (32K)",
          "max_tokens": 4096,
          "tool_call": true,
          "reasoning": true
        },
        "qwen35-9b-local": {
          "name": "Qwen3.5 9B AWQ Local (32K)",
          "max_tokens": 4096,
          "tool_call": true,
          "reasoning": true
        },
        "gemma4-8b-local": {
          "name": "Gemma 4 8B Local (32K)",
          "max_tokens": 4096,
          "tool_call": true,
          "reasoning": true
        }
      }
    }
  },
  "mcp": {
    "safe-edit": {
      "type": "local",
      "command": [
        "node",
        ".opencode/mcp/safe-edit/server.js"
      ],
      "enabled": true
    },
    "websearch": {
      "type": "local",
      "command": [
        "node",
        ".opencode/mcp/websearch/server.js"
      ],
      "enabled": true
    },
    "html-check": {
      "type": "local",
      "command": [
        "node",
        ".opencode/mcp/html-check/server.js"
      ],
      "enabled": true
    }
  }
}

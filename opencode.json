{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "vram16-vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local 16vram vLLM",
      "options": {
        "baseURL": "http://127.0.0.1:8002/v1",
        "apiKey": "local",
        "timeout": 900000,
        "chunkTimeout": 600000
      },
      "models": {
        "active-model": {
          "name": "Qwen3.8",
          "limit": {
            "context": 100000,
            "output": 8192
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "minimal": {
              "disabled": true
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "disabled": true
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "disabled": true
            }
          },
          "options": {
            "reasoningEffort": "low"
          },
          "max_tokens": 8192,
          "tool_call": true,
          "reasoning": true
        }
      }
    },
    "ieti-agents": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "IETI Agents",
      "options": {
        "baseURL": "https://agents.ieti.site/v1",
        "apiKey": "{file:.secrets/agents_server_key}",
        "timeout": 900000,
        "chunkTimeout": 600000
      },
      "models": {
        "deepseek-model": {
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "minimal": {
              "disabled": true
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "disabled": true
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "disabled": true
            },
            "max": {
              "reasoningEffort": "max"
            }
          },
          "options": {
            "reasoningEffort": "low"
          }
        },
        "active-model": {
          "limit": {
            "context": 90000,
            "output": 8192
          },
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "minimal": {
              "disabled": true
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "disabled": true
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "disabled": true
            }
          },
          "options": {
            "reasoningEffort": "low"
          }
        }
      }
    }
  },
  "model": "ieti-agents/deepseek-model",
  "default_agent": "build_lite"
}

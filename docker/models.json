      "container": "qwen35_9b_quanttrio_spark_vllm",
      "engine": "vllm",
      "volumes": ["xtec-hf-cache", "xtec-vllm-cache"],
      "description": "QuantTrio Qwen3.5 9B AWQ Spark vLLM profile."
    },
    "qwen3-14b-spark": {
      "compose": "docker-compose-qwen3-14b-spark.yml",
      "container": "qwen3_14b_awq_vllm",
      "engine": "vllm",
      "volumes": ["xtec-hf-cache", "xtec-vllm-cache"],
      "description": "Qwen3 14B AWQ Spark vLLM profile."
    },
    "qwen3-8b": {
      "compose": "docker-compose-qwen3-8b.yml",
      "container": "qwen3_8b_awq_vllm",
      "engine": "vllm",
      "volumes": ["xtec-hf-cache", "xtec-vllm-cache"],
      "description": "Qwen3 8B AWQ local vLLM profile."
    }
  }

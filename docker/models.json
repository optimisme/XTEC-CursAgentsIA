    "gemma4-8b-spark": {
      "compose": "docker-compose-gemma4-8b-spark.yml",
      "container": "gemma4_8b_spark_vllm",
      "engine": "vllm",
      "volumes": ["xtec-hf-cache", "xtec-vllm-cache"],
      "description": "Gemma 4 8B Spark BF16 profile."
    },
    "qwen3.6-35b-a3b-mtp-iq4-llamacpp": {
      "compose": "docker-compose-qwen36-35b-a3b-mtp-iq4-llamacpp.yml",
      "container": "qwen36_35b_a3b_mtp_iq4_llamacpp",
      "engine": "llamacpp",
      "volumes": ["xtec-hf-cache", "xtec-gguf-cache"],

{
  "compose_project": "vllm",
  "default_model": "gemma4-31b-qat-w4a16-spark",
  "endpoint": "http://127.0.0.1:8000/v1",
  "volumes": {
    "xtec-hf-cache": {
      "description": "Shared Hugging Face cache for model weights, tokenizers, and snapshots."
    },
    "xtec-vllm-cache": {
      "description": "Runtime cache used by vLLM containers."
    },
    "xtec-gguf-cache": {
      "description": "GGUF and llama.cpp cache used by llama.cpp containers."
    }
  },
  "models": {
    "gemma4-31b-qat-w4a16-spark": {
      "compose": "docker-compose-gemma4-31b-qat-w4a16-spark.yml",
      "container": "gemma4_31b_qat_w4a16_spark_vllm",
      "engine": "vllm",
      "volumes": ["xtec-hf-cache", "xtec-vllm-cache"],
      "description": "Default Gemma 4 31B QAT W4A16 Spark profile."
    },
    "gemma4-26b-a4b-spark": {
      "compose": "docker-compose-gemma4-26b-a4b-spark.yml",
      "container": "gemma4_26b_a4b_spark_vllm",
      "engine": "vllm",
      "volumes": ["xtec-hf-cache", "xtec-vllm-cache"],
      "description": "Gemma 4 26B A4B Spark BF16 profile."
    },
    "diffusiongemma-26b-a4b-spark": {
      "compose": "docker-compose-diffusiongemma-26b-a4b-spark.yml",
      "container": "diffusiongemma_26b_a4b_spark_vllm",
      "engine": "vllm",
      "volumes": ["xtec-hf-cache", "xtec-vllm-cache"],
      "description": "DiffusionGemma 26B A4B Spark vLLM profile."
    },
    "gemma4-12b-qat-w4a16-spark": {
      "compose": "docker-compose-gemma4-12b-qat-w4a16-spark.yml",
      "container": "gemma4_12b_qat_w4a16_spark_vllm",
      "engine": "vllm",
      "volumes": ["xtec-hf-cache", "xtec-vllm-cache"],
      "description": "Gemma 4 12B QAT W4A16 Spark profile."
    },
    "gemma4-12b-qat-w4a16-vllm": {
      "compose": "docker-compose-gemma4-12b-qat-w4a16-vllm.yml",
      "container": "gemma4_12b_qat_w4a16_vllm",
      "engine": "vllm",
      "volumes": ["xtec-hf-cache", "xtec-vllm-cache"],
      "description": "Gemma 4 12B QAT W4A16 local vLLM profile."
    },
    "gemma4-8b": {
      "compose": "docker-compose-gemma4-8b.yml",
      "container": "gemma4_8b_vllm",
      "engine": "vllm",
      "volumes": ["xtec-hf-cache", "xtec-vllm-cache"],
      "description": "Gemma 4 8B local BitsAndBytes profile."

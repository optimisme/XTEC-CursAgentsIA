{
  "$schema": "https://opencode.ai/config.json",
  "model": "ieti-agents/active-model",
  "default_agent": "build",
  "enabled_providers": ["ieti-agents", "opencode", "vram16-vllm", "spark-vllm"],
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "bash": "allow",
    "edit": "allow",
    "write": "allow",
    "task": "allow"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 4096
  },
  "snapshot": false,
  "instructions": [],
  "provider": {
    "opencode": {
      "options": {
        "apiKey": "{env:OPENCODE_ZEN_API_KEY}",
        "timeout": 900000,
        "chunkTimeout": 600000
      }
    },
    "ieti-agents": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "IETI Agents",
      "options": {
        "baseURL": "https://agents.ieti.site/v1",
        "apiKey": "{env:IETI_AGENT_KEY}",
        "timeout": 900000,
        "chunkTimeout": 600000
      },
      "models": {
        "active-model": {
          "name": "Active Model",
          "limit": {
            "context": 32768,
            "output": 4096
          },
          "max_tokens": 4096,
          "tool_call": true,
          "reasoning": true
        }
      }
    },
    "vram16-vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "16GB vLLM",
      "options": {
        "baseURL": "http://127.0.0.1:8002/v1",
        "apiKey": "local",
        "timeout": 900000,
        "chunkTimeout": 600000
      },
      "models": {
        "active-model": {
          "name": "Active Model",
          "limit": {
            "context": 32768,
            "output": 4096
          },
          "max_tokens": 4096,
          "tool_call": true,
          "reasoning": true
        }
      }
    },
    "spark-vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Spark vLLM",
      "options": {
        "baseURL": "http://127.0.0.1:8001/v1",
        "apiKey": "local",
        "timeout": 900000,
        "chunkTimeout": 600000
      },
      "models": {
        "active-model": {
          "name": "Active Model",
          "limit": {
            "context": 32768,
            "output": 4096
          },
          "max_tokens": 4096,
          "tool_call": true,
          "reasoning": true
        }
      }
    }
  }
}

      "properties": {
        "Node name for S&R": "ClassroomText"
      },
      "widgets_values": [
        "{\n  \"scenes\": [\n    {\n      \"narration\": \"When you open a website, your browser needs to find its server. If it does not already know the address, it uses DNS to look up an IP address for the website's name.\",\n      \"image_prompt\": \"Clean educational flat illustration of a laptop beside an address book and a server rack, visual metaphor for looking up a website address, navy and turquoise palette, white background, generous empty space, no text, no letters, no logos\"\n    },\n    {\n      \"narration\": \"The browser connects to the server and sends an HTTP request for a resource, such as a page. With HTTPS, the connection is encrypted to help protect information while it travels.\",\n      \"image_prompt\": \"Clean educational flat illustration of a laptop sending a small envelope towards a server rack, a padlock representing an encrypted connection, navy and turquoise palette, white background, generous empty space, no text, no letters, no logos\"\n    },\n    {\n      \"narration\": \"The server sends a response. The browser processes the page and may request more resources, such as images, style sheets and scripts. Together, these resources help build the page you see.\",\n      \"image_prompt\": \"Clean educational flat illustration of a laptop showing a simple web page assembled from a picture tile, coloured layout blocks and a document, server rack in the background, navy and turquoise palette, white background, generous empty space, no text, no letters, no logos\"\n    }\n  ]\n}\n"
      ]
    },

{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ieti-agents": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "IETI Agents",
      "options": {
        "baseURL": "https://agents.ieti.site/v1",
        "apiKey": "{env:PROXY_AGENTS_KEY}",
        "timeout": 900000,
        "chunkTimeout": 600000
      }
    }
  },
  "model": "ieti-agents/active-model",
  "mcp": {
    "local-rag": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "mcp-local-rag"
      ],
      "env": {
        "BASE_DIR": "./documents",
        "DB_PATH": "./.rag/lancedb",
        "CACHE_DIR": "./.rag/models"
      }
    }
  }
}

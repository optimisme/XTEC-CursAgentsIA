{
  "$schema": "https://opencode.ai/config.json",
  "model": "vram16-vllm/active-model",
  "default_agent": "goal_lite",
  "enabled_providers": ["ieti-agents", "vram16-vllm", "spark-vllm", "opencode"],
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "bash": "deny",
    "edit": "deny",
    "task": "allow",
    "todowrite": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "lsp": "deny",
    "skill": "deny"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 4096
  },
  "snapshot": false,
  "instructions": [
    "AGENTS.md"
  ],
  "provider": {
    "ieti-agents": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "IETI Agents",
      "options": {
        "baseURL": "https://agents.ieti.site/v1",
        "apiKey": "{env:IETI_AGENT_KEY}",
        "timeout": 900000,
        "chunkTimeout": 600000
      },
      "models": {
        "active-model": {
          "name": "Active Model",
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "max_tokens": 8192,
          "tool_call": true,
          "reasoning": false
        }
      }
    },
    "vram16-vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "16GB llama.cpp",
      "options": {
        "baseURL": "http://127.0.0.1:8002/v1",
        "apiKey": "local",
        "timeout": 900000,
        "chunkTimeout": 600000
      },
      "models": {
        "active-model": {
          "name": "Active Model",
          "limit": {
            "context": 65536,
            "output": 2048
          },
          "max_tokens": 2048,
          "tool_call": true,
          "reasoning": false
        }
      }
    },
    "spark-vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Spark vLLM",
      "options": {
        "baseURL": "http://127.0.0.1:8001/v1",
        "apiKey": "local",
        "timeout": 900000,
        "chunkTimeout": 600000
      },
      "models": {
        "active-model": {
          "name": "Active Model",
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "max_tokens": 8192,
          "tool_call": true,
          "reasoning": false
        }
      }
    }
  },
  "mcp": {
    "safe_edit": {
      "type": "local",
      "command": [
        "node",
        ".opencode/mcp/safe_edit/server.js"
      ],
      "enabled": true
    },
    "web_check": {
      "type": "local",
      "command": [
        "node",
        ".opencode/mcp/web_check/server.js"
      ],
      "enabled": true
    },
    "web_research": {
      "type": "local",
      "command": [
        "node",
        ".opencode/mcp/web_research/server.js"
      ],
      "enabled": true
    },
    "image_vision": {
      "type": "local",
      "command": [
        "node",
        ".opencode/mcp/image_vision/server.js"
      ],
      "enabled": true
    },
    "agent_contract": {
      "type": "local",
      "command": [
        "node",
        ".opencode/mcp/agent_contract/server.js"
      ],
      "enabled": true
    }
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "model": "ieti-agents/active-model",
  "enabled_providers": ["ieti-agents"],
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "bash": "deny",
    "edit": "deny",
    "task": "allow",
    "todowrite": "deny",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "deny",
    "skill": "deny"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 4096
  },
  "snapshot": false,
  "instructions": [
    "AGENTS.md"
  ],
  "provider": {
    "ieti-agents": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "IETI Agents",
      "options": {
        "baseURL": "https://agents.ieti.site/v1",
        "apiKey": "{env:IETI_AGENT_KEY}",
        "timeout": 900000,
        "chunkTimeout": 600000
      },
      "models": {
        "active-model": {
          "name": "Active Model",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "max_tokens": 8192,
          "tool_call": true,
          "reasoning": false
        }
      }
    }
  },
  "mcp": {
    "safe-edit": {
      "type": "local",
      "command": [
        "node",
        ".opencode/mcp/safe-edit/server.js"
      ],
      "enabled": false
    },
    "web-check": {
      "type": "local",
      "command": [
        "node",
        ".opencode/mcp/web-check/server.js"
      ],
      "enabled": false
    }
  }
}
